# Copy this file to .env and add your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional: change the models if Google renames them
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# Optional: save chat history in Supabase (run supabase.sql first).
# Use the secret service_role key. It stays on the backend only.
SUPABASE_URL=
SUPABASE_KEY=

# Optional: the address of the hosted frontend, for CORS (default http://localhost:3000)
FRONTEND_URL=

# Optional: hours before guest papers are deleted (signed-in papers are kept)
GUEST_HOURS=12
